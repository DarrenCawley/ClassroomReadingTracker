{
  "name": "school_book_tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "run-p dev:web dev:api",
    "dev:web": "npm run dev -w @school/web",
    "dev:api": "npm run dev -w @school/api",
    "db:generate": "npm run db:generate -w @school/api --",
    "db:migrate": "npm run db:migrate -w @school/api",
    "build": "npm run build --workspaces",
    "preview": "npm run preview -w @school/web",
    "test:unit": "npm run test:unit -w @school/web --",
    "type-check": "npm run type-check --workspaces && npm run type-check:tooling",
    "type-check:tooling": "tsc --project tsconfig.node.json",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write apps/web/src/ apps/api/src/"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
